{
  "name": "polka",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm --recursive run test && pnpm --filter @polka/server exec vitest run --dir ../../scripts/model-experiment",
    "lint": "pnpm --recursive run lint",
    "format": "pnpm --recursive run format",
    "screenshots": "node scripts/take-screenshots.ts",
    "model-experiment": "node --env-file-if-exists=.env scripts/model-experiment/index.ts"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.65.0"
  }
}
